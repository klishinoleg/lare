# Copy to tests_env/codex-local.env for local Codex Linux-container runs.
# Keep the real file ignored: it may contain bot/API/Google credential values.

TG_BOT_TOKEN=
TG_PAYMENT_PROVIDER_TOKEN=

READER_AI_PROVIDER=deepseek
READER_AI_OPENAI_API_KEY=
READER_AI_OPENAI_BASE_URL=https://api.deepseek.com
READER_AI_OPENAI_CHAT_MODEL=deepseek-v4-flash

READER_AI_VOICE_PROVIDER=google
READER_AI_GOOGLE_TTS_LANGUAGE_CODE=en-US
READER_AI_GOOGLE_TTS_GENDER=MALE
GOOGLE_APPLICATION_CREDENTIALS=/workspace/secrets/google-tts.json
